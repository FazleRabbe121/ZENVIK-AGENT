# ============================================================================
# ZENVIK-AGENT — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Never commit real secrets or API keys. Use Google Cloud Secret Manager in prod.
# ============================================================================

# Server Runtime (Cloud Run automatically injects PORT=8080 and NODE_ENV=production)
NODE_ENV="development"
PORT="3000"

# APP_URL / SHARED_APP_URL: Public URLs where this application is hosted (used for OAuth callbacks & API links)
APP_URL="MY_APP_URL"
SHARED_APP_URL=""
VITE_BACKEND_URL="https://YOUR_CLOUD_RUN_SERVICE_URL.run.app"
ALLOWED_CORS_ORIGINS="https://appassets.androidplatform.net,https://fazlerabbe121.github.io"

# ============================================================================
# AI PROVIDERS (Server-Side Only — Never Expose in Browser Bundle)
# ============================================================================
# Primary AI Provider: Google Gemini (@google/genai) — used for Guest Mode & fallback when user has no BYOK key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# Secondary AI Provider: OpenAI Verification & Chat
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Tertiary AI Provider: Grok (xAI) Cross-Verification
GROK_API_KEY=""
XAI_API_KEY=""
GROK_MODEL="grok-2-latest"

# Existing Primary AI Model System Identifier (Strictly Preserved)
EXISTING_AI_SYSTEM_NAME="GEN MODEL GEN HASH 1"

# ============================================================================
# MULTI-USER SAAS & PERSONAL GMAIL OAUTH 2.0 CONFIGURATION
# (Store secrets in Google Cloud Secret Manager for Cloud Run deployment)
# ============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
TOKEN_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_AES_256_GCM_SECRET_FROM_SECRET_MANAGER"
SESSION_SIGNING_SECRET="REPLACE_WITH_RANDOM_32_BYTE_HMAC_SESSION_SECRET"
FINANCE_WEBHOOK_SECRET="REPLACE_WITH_RANDOM_WEBHOOK_VERIFICATION_SECRET"

# ============================================================================
# CONTROLLED GUEST PREVIEW MODE (Server-Enforced 2-4 Minute Window)
# ============================================================================
# Duration in seconds (clamped server-side to 120..240, default 180 = 3 minutes)
GUEST_SESSION_DURATION_SECONDS="180"
# Cooldown per client fingerprint before a new guest preview can be requested
GUEST_COOLDOWN_SECONDS="1800"
# Optional server-side Owner Gmail relay strictly for confirmed Guest Mode preview sends
# (Registered users NEVER use this; they must connect their own personal Gmail via OAuth)
OWNER_GMAIL_ADDRESS=""
OWNER_GMAIL_REFRESH_TOKEN=""

# ============================================================================
# DATABASE & CLOUD INTEGRATIONS (Firebase + Optional PostgreSQL / Supabase)
# ============================================================================
FIREBASE_PROJECT_ID=""
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zenvik_agent?sslmode=require"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================================================
# CAREERPILOT PERSONAL AI AGENT ENGINE (ISOLATED SELF-HOSTED CONFIGURATION)
# ============================================================================
# Activation state: Development | Testing | Ready for Review | Approved | Active | Disabled
PERSONAL_AI_ACTIVATION_STATE="Ready for Review"
AGENT_MODEL_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/api"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_TIMEOUT_MS="90000"
OLLAMA_KEEP_ALIVE="10m"
OLLAMA_BEARER_TOKEN=""

# Scheduler & Execution Policy Bounds
AGENT_SCHEDULER_SECRET="REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_SECRET"
AGENT_AUTO_SEND_ENABLED="false"
AGENT_ALLOW_APPROVED_EMAIL_SEND="false"
AGENT_MAX_STEPS_PER_RUN="18"
AGENT_MAX_RUN_DURATION_MS="300000"
AGENT_MAX_JOBS_PER_SOURCE="250"
AGENT_MAX_SOURCES_PER_RUN="30"
AGENT_MAX_DAILY_RUNS="1"
AGENT_REQUEST_TIMEOUT_MS="20000"
AGENT_JOB_RETENTION_DAYS="180"
AGENT_AUDIT_RETENTION_DAYS="365"

# Official Public Job Board Connectors (JSON arrays)
GREENHOUSE_BOARD_TOKENS_JSON="[]"
LEVER_SITES_JSON="[]"

# Document Intelligence & PDF Engine
DOCUMENT_FONT_PATH=""
DOCUMENT_MAX_OUTPUT_BYTES="15000000"
DOCUMENT_MAX_PAGES="250"
