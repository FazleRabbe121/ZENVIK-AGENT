rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-+.@]+$');
    }

    // Test connection doc used to verify database connectivity
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Dynamic CV Users & Accounts (CV-Only Workspace compatibility with enumeration & deletion protection)
    match /cv_accounts/{accountId} {
      allow get, create, update: if isValidId(accountId);
      allow list, delete: if isSignedIn() && isValidId(accountId);
      match /{subcollection=**} {
        allow get, create, update: if isValidId(accountId);
        allow list, delete: if isSignedIn() && isValidId(accountId);
      }
    }

    match /cv_users/{phoneNumber} {
      allow get, create, update: if isValidId(phoneNumber);
      allow list, delete: if isSignedIn() && isValidId(phoneNumber);
      match /{subcollection=**} {
        allow get, create, update: if isValidId(phoneNumber);
        allow list, delete: if isSignedIn() && isValidId(phoneNumber);
      }
    }

    // Strict User-Isolated Data Tree:
    // Every read and write is strictly restricted to the authenticated user matching the UID.
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // All subcollections (workspace, cvLibrary, cvDocuments, savedJobs, applications, gmailQueue, settings, relapses, finance, familyMoney, recipes, reports, interviewAttempts)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
